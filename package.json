{
  "name": "aided-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "yarn workspace playground dev",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "yarn workspace aided-core build",
    "build:lint": "yarn lint && yarn build",
    "build:test": "yarn build:lint && yarn coverage",
    "test:e2e": "testcafe chrome:headless,firefox:headless e2e/tests",
    "test:e2e:chrome": "testcafe chrome:headless e2e/tests",
    "test:e2e:firefox": "testcafe firefox:headless e2e/tests",
    "test:e2e:headed": "testcafe chrome,firefox e2e/tests",
    "test:e2e:debug": "testcafe chrome e2e/tests --debug-on-fail"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/web-worker": "^3.2.6",
    "csstype": "^3.2.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.10.3",
    "jsdom": "^27.4.0",
    "testcafe": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.10"
  },
  "packageManager": "yarn@4.17.0"
}
